{
  "name": "harold-scripts",
  "version": "1.4.1",
  "description": "Harold JS Scripts for Create Harold App",
  "author": "Julian Ćwirko (julian.io)",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "bin": {
    "harold-scripts": "bin/harold-scripts.js"
  },
  "homepage": "https://www.haroldjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harold-js/harold-scripts.git"
  },
  "keywords": [
    "blogging",
    "static-site-generator",
    "javascript",
    "generator",
    "jamstack"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint . --fix",
    "prettier": "prettier --write '**/*.{js,json}'",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "10.4.27",
    "chalk": "5.6.2",
    "chokidar": "5.0.0",
    "cosmiconfig": "9.0.1",
    "cross-spawn": "7.0.6",
    "cssnano": "7.1.3",
    "dateformat": "5.0.3",
    "deepmerge": "4.3.1",
    "fs-extra": "11.3.4",
    "glob": "13.0.6",
    "handlebars": "4.7.9",
    "hast-util-sanitize": "5.0.2",
    "html-minifier-terser": "7.2.0",
    "image-size": "2.0.2",
    "postcss": "8.5.8",
    "rehype-format": "5.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sass": "1.98.0",
    "serve-handler": "6.1.7",
    "to-vfile": "8.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile-matter": "5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
